class SinglyNode:
    def __init__(self, val, next = None):
            self.val = val
            self.next = next

    def __str__(self):
            return str(self.val)


Head = SinglyNode(1) # head start hota ha
A = SinglyNode(3) # A is the first node
B = SinglyNode(5) # B is the second node
C = SinglyNode(7) # C is the third node

# to connect these nodes together we will use the next pointer of each node
Head.next = A
A.next = B
B.next = C

